exports[`signed-in routine UI > renders active and archived routines with a start button as before 1`] = `"<div class="flex flex-col gap-8"><ul class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface"><li class="flex items-center gap-3 px-4 py-3"><div class="min-w-0 flex-1"><p class="truncate font-medium text-fg">Push day</p><p class="mt-0.5 text-sm text-fg-subtle">2 exercises</p></div><button data-start-routine="5" aria-label="Start Push day">Start</button><a href="/routines/5/edit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm" aria-label="Edit Push day">Edit</a><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="id" value="5"/><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm" aria-label="Archive Push day">Archive</button></form></li></ul><details class="group"><summary class="cursor-pointer text-sm font-medium text-fg-muted hover:text-fg">Archived (1)</summary><ul class="mt-3 divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface-sunken"><li class="flex items-center gap-3 px-4 py-3"><div class="min-w-0 flex-1"><p class="truncate text-fg-muted">Legs</p><p class="mt-0.5 text-sm text-fg-subtle">1 exercise</p></div><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="id" value="6"/><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 border border-border-strong bg-surface text-fg hover:bg-surface-sunken h-9 px-3 text-sm" aria-label="Restore Legs">Restore</button></form></li></ul></details></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

exports[`signed-in routine UI > renders the empty list as before 1`] = `"<div class="flex flex-col gap-8"><div class="rounded-xl border border-dashed border-border-strong px-6 py-12 text-center"><p class="font-medium text-fg">No routines yet</p><p class="mt-1 text-sm text-fg-muted">Group your exercises into a routine with target sets, reps and rest.</p><a href="/routines/new" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-active h-11 px-4 text-base mt-5">Create your first routine</a></div></div>"`;

exports[`signed-in routine UI > renders the form as before 1`] = `"<form class="flex flex-col gap-5" noValidate="" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><div class="flex flex-col gap-1.5"><label for="name" class="text-sm font-medium text-fg">Name</label><input id="name" required="" maxLength="120" placeholder="e.g. Push day" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="name" value=""/></div><div class="flex flex-col gap-1.5"><label for="description" class="text-sm font-medium text-fg">Description <span class="font-normal text-fg-subtle">(optional)</span></label><textarea id="description" name="description" maxLength="1000" placeholder="Goal, schedule, warm-up…" class="min-h-24 py-2 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger"></textarea></div><fieldset class="flex flex-col gap-3"><legend class="text-sm font-medium text-fg mb-1.5">Exercises</legend><ol class="flex flex-col gap-3"><li class="flex flex-col gap-3 rounded-lg border border-border bg-surface-sunken p-3"><div class="flex flex-col gap-1.5"><div class="flex items-center justify-between gap-2"><label for="items-0-exerciseId" class="text-sm font-medium text-fg">Exercise 1</label><div class="flex items-center gap-1"><button type="button" disabled="" aria-label="Move exercise 1 up" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm"><span aria-hidden="true">↑</span></button><button type="button" disabled="" aria-label="Move exercise 1 down" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm"><span aria-hidden="true">↓</span></button><button type="button" aria-label="Remove exercise 1" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm">Remove</button></div></div><select id="items-0-exerciseId" name="items.0.exerciseId" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger"><option value="" disabled="" selected="">Choose an exercise…</option><option value="3">Squat</option><option value="4">Curl (archived)</option></select></div><div class="grid grid-cols-2 gap-3 sm:grid-cols-4"><div class="flex min-w-0 flex-col gap-1.5"><label for="items-0-targetSets" class="text-sm font-medium text-fg">Sets<span class="sr-only"> for exercise 1</span></label><input id="items-0-targetSets" type="number" inputMode="numeric" min="1" max="20" step="1" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="items.0.targetSets" value="3"/></div><div class="flex min-w-0 flex-col gap-1.5"><label for="items-0-targetRepsMin" class="text-sm font-medium text-fg">Min reps<span class="sr-only"> for exercise 1</span></label><input id="items-0-targetRepsMin" type="number" inputMode="numeric" min="1" max="100" step="1" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="items.0.targetRepsMin" value="8"/></div><div class="flex min-w-0 flex-col gap-1.5"><label for="items-0-targetRepsMax" class="text-sm font-medium text-fg">Max reps<span class="sr-only"> for exercise 1</span></label><input id="items-0-targetRepsMax" type="number" inputMode="numeric" min="1" max="100" step="1" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="items.0.targetRepsMax" value="12"/></div><div class="flex min-w-0 flex-col gap-1.5"><label for="items-0-restSeconds" class="text-sm font-medium text-fg">Rest (s)<span class="sr-only"> for exercise 1</span></label><input id="items-0-restSeconds" type="number" inputMode="numeric" min="0" max="600" step="1" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="items.0.restSeconds" value="90"/></div></div><div class="flex flex-col gap-1.5"><label for="items-0-notes" class="text-sm font-medium text-fg">Notes <span class="font-normal text-fg-subtle">(optional)</span><span class="sr-only"> for exercise 1</span></label><input id="items-0-notes" maxLength="500" placeholder="Tempo, pauses, cues…" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="items.0.notes" value=""/></div></li></ol><button type="button" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 border border-border-strong bg-surface text-fg hover:bg-surface-sunken h-9 px-3 text-sm self-start">Add exercise</button></fieldset><div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><a href="/routines" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 border border-border-strong bg-surface text-fg hover:bg-surface-sunken h-11 px-4 text-base">Cancel</a><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-active h-11 px-4 text-base">Create routine</button></div></form><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

exports[`signed-in exercise UI > renders active and archived exercises as before 1`] = `"<div class="flex flex-col gap-8"><ul class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface"><li class="flex items-center gap-3 px-4 py-3"><div class="min-w-0 flex-1"><p class="truncate font-medium text-fg">Squat</p><span class="mt-1 inline-block rounded-full bg-primary-subtle px-2 py-0.5 text-xs font-medium text-on-primary-subtle">Legs</span></div><a href="/exercises/3/edit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm" aria-label="Edit Squat">Edit</a><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="id" value="3"/><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 text-fg-muted hover:bg-surface-sunken hover:text-fg h-9 px-3 text-sm" aria-label="Archive Squat">Archive</button></form></li></ul><details class="group"><summary class="cursor-pointer text-sm font-medium text-fg-muted hover:text-fg">Archived (1)</summary><p class="mt-2 text-sm text-fg-subtle">Archived exercises keep their history and are hidden from new routines.</p><ul class="mt-3 divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface-sunken"><li class="flex items-center gap-3 px-4 py-3"><div class="min-w-0 flex-1"><p class="truncate text-fg-muted">Curl</p><span class="mt-1 inline-block rounded-full bg-primary-subtle px-2 py-0.5 text-xs font-medium text-on-primary-subtle">Biceps</span></div><form action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><input type="hidden" name="id" value="4"/><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 border border-border-strong bg-surface text-fg hover:bg-surface-sunken h-9 px-3 text-sm" aria-label="Restore Curl">Restore</button></form></li></ul></details></div><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;

exports[`signed-in exercise UI > renders the empty list as before 1`] = `"<div class="flex flex-col gap-8"><div class="rounded-xl border border-dashed border-border-strong px-6 py-12 text-center"><p class="font-medium text-fg">No exercises yet</p><p class="mt-1 text-sm text-fg-muted">Add the exercises you train so you can build routines and log your sets.</p><a href="/exercises/new" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-active h-11 px-4 text-base mt-5">Add your first exercise</a></div></div>"`;

exports[`signed-in exercise UI > renders the form as before 1`] = `"<form class="flex flex-col gap-5" noValidate="" action="javascript:throw new Error(&#x27;React form unexpectedly submitted.&#x27;)"><div class="flex flex-col gap-1.5"><label for="name" class="text-sm font-medium text-fg">Name</label><input id="name" required="" maxLength="120" placeholder="e.g. Bench press" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger" name="name" value="Squat"/></div><div class="flex flex-col gap-1.5"><label for="muscleGroup" class="text-sm font-medium text-fg">Muscle group</label><select id="muscleGroup" name="muscleGroup" required="" class="h-11 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger"><option value="" disabled="">Choose one…</option><option value="chest">Chest</option><option value="back">Back</option><option value="shoulders">Shoulders</option><option value="biceps">Biceps</option><option value="triceps">Triceps</option><option value="legs" selected="">Legs</option><option value="glutes">Glutes</option><option value="core">Core</option><option value="full_body">Full body</option><option value="other">Other</option></select></div><div class="flex flex-col gap-1.5"><label for="notes" class="text-sm font-medium text-fg">Notes <span class="font-normal text-fg-subtle">(optional)</span></label><textarea id="notes" name="notes" maxLength="1000" placeholder="Grip, setup, cues…" class="min-h-24 py-2 w-full rounded-md border border-border-strong bg-surface px-3 text-base text-fg placeholder:text-fg-subtle transition-colors duration-(--duration-fast) focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring/30 aria-invalid:border-danger"></textarea></div><div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"><a href="/exercises" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 border border-border-strong bg-surface text-fg hover:bg-surface-sunken h-11 px-4 text-base">Cancel</a><button type="submit" class="inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors duration-(--duration-fast) disabled:cursor-not-allowed disabled:opacity-60 bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-active h-11 px-4 text-base">Save changes</button></div></form><script>addEventListener("submit",function(a){if(!a.defaultPrevented){var b=a.target,d=a.submitter,c=b.action,e=d;if(d){var f=d.getAttribute("formAction");null!=f&&(c=f,e=null)}"javascript:throw new Error('React form unexpectedly submitted.')"===c&&(a.preventDefault(),a=new FormData(b,e),c=b.ownerDocument||b,(c.$$reactFormReplay=c.$$reactFormReplay||[]).push(b,d,a))}});</script>"`;
